{
  "name": "h100_qwen3_8b_specbench_baseline",
  "platform": "cuda",
  "image": "suffix-vllm-cuda:latest",
  "container_name": "suffixbench_h100_specbench_base",
  "model": "Qwen/Qwen3-8B",
  "served_model_name": "qwen3-8b",
  "port": 18085,
  "gpus": "device=0",
  "server_args": {
    "trust_remote_code": true,
    "tensor_parallel_size": 1,
    "max_model_len": 4096,
    "max_num_batched_tokens": 8192,
    "gpu_memory_utilization": 0.9,
    "disable_log_requests": true
  },
  "bench": {
    "dataset_name": "spec_bench",
    "dataset_path": "/workspace/suffix-bench/data/spec_bench/question.jsonl",
    "num_prompts": 200,
    "request_rate": "inf",
    "max_concurrency": 8,
    "spec_bench_output_len": 512,
    "temperature": 0
  }
}
