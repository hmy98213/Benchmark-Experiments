{
  "name": "h100_qwen3_8b_prefixrep_baseline",
  "platform": "cuda",
  "image": "suffix-vllm-cuda:latest",
  "container_name": "suffixbench_h100_prefixrep_base",
  "model": "Qwen/Qwen3-8B",
  "served_model_name": "qwen3-8b",
  "port": 18083,
  "gpus": "device=0",
  "server_args": {
    "trust_remote_code": true,
    "tensor_parallel_size": 1,
    "max_model_len": 4096,
    "max_num_batched_tokens": 8192,
    "gpu_memory_utilization": 0.9,
    "disable_log_requests": true
  },
  "bench": {
    "dataset_name": "prefix_repetition",
    "num_prompts": 64,
    "request_rate": "inf",
    "max_concurrency": 8,
    "prefix_repetition_prefix_len": 512,
    "prefix_repetition_suffix_len": 512,
    "prefix_repetition_num_prefixes": 8,
    "prefix_repetition_output_len": 256,
    "ignore_eos": true,
    "temperature": 0
  }
}
