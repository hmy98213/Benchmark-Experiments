ARG BASE_IMAGE=vllm/vllm-openai:latest
FROM ${BASE_IMAGE}

ARG ARCTIC_INFERENCE_VERSION=0.1.2
RUN /usr/bin/python3.12 -c "import importlib.util; raise SystemExit(0 if importlib.util.find_spec('arctic_inference') else 1)" \
    || (apt-get update \
        && apt-get install -y --no-install-recommends cmake python3.12-dev \
        && rm -rf /var/lib/apt/lists/* \
        && /usr/bin/python3.12 -m pip install --no-cache-dir -i https://pypi.org/simple nanobind==2.9.2 grpcio-tools \
        && CMAKE_ARGS="-DPython_EXECUTABLE=/usr/bin/python3.12" /usr/bin/python3.12 -m pip install --no-build-isolation --no-cache-dir -i https://pypi.org/simple "arctic-inference==${ARCTIC_INFERENCE_VERSION}")
